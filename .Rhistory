# 1. Clean data coordinates
shot_data %>%
mutate(
LOC_X = as.numeric(LOC_X),
LOC_Y = as.numeric(LOC_Y)
) %>%
ggplot(aes(x = LOC_X, y = LOC_Y)) +
# 1. Court Outer Boundaries (Moved outside aes to eliminate warnings)
geom_rect(xmin = -250, xmax = 250, ymin = -50, ymax = 420,
fill = NA, color = "black", linewidth = 0.8) +
# 2. The Key / Paint box
geom_rect(xmin = -80, xmax = 80, ymin = -50, ymax = 140,
fill = NA, color = "black", linewidth = 0.8) +
# 3. Straight Corner 3pt Side Segments
geom_segment(x = 220, xend = 220, y = -50, yend = 89.48, color = "black") +
geom_segment(x = -220, xend = -220, y = -50, yend = 89.48, color = "black") +
# 4. Perfect 3-Point Circle Arc (Calibrated for scale_y_reverse)
geom_function(
fun = function(x) { sqrt(237.5^2 - x^2) },
xlim = c(-220, 220),
color = "blue",
linewidth = 1
) +
# 5. Shot Data Points
geom_point(aes(color = factor(SHOT_MADE_FLAG)), alpha = 0.7, size = 2) +
# 6. Scales, Flipping, and Locking Layout Aspect Ratios
scale_y_reverse(limits = c(420, -50)) +
scale_x_continuous(limits = c(-250, 250)) +
scale_color_manual(values = c("0" = "#DF6565", "1" = "#62A062")) +
coord_fixed() +
theme_void() +
theme(legend.position = "none")
