LOC_Y = as.numeric(LOC_Y)
)%>%
ggplot(aes(x = LOC_X, y = LOC_Y)) +
geom_rect(aes(xmin = -250, xmax = 250, ymin = -50, ymax = 420),
fill = NA, color = "black", size = 0.8) +
# The Key / Paint box
geom_rect(aes(xmin = -80, xmax = 80, ymin = -50, ymax = 140),
fill = NA, color = "black", size = 0.8)+
geom_segment(aes(x = 220, xend = 220, y = -50, yend = 90),color="black")+
geom_segment(aes(x = -220, xend = -220, y = -50, yend = 90),color="black")+
geom_function(fun=function(x){(x/(-20))^2 +250},  color = "blue", size = 1)+
geom_point(aes(color = factor(SHOT_MADE_FLAG)), alpha = 0.7, size = 2) +
scale_y_reverse(limits = c(420, -50)) +
scale_x_continuous(limits = c(-250, 250)) +
scale_color_manual(
values = c("0" = "#DF6565", "1" = "#62A062"))+
coord_fixed() +
theme_void()+
theme(legend.position = "none")
